# Copiez ce fichier en .env puis renseignez les deux valeurs.
# Sans elles, l'application démarre en mode démo : comptes et données
# restent dans le navigateur.
#
# Settings -> API Keys dans votre projet Supabase.
# La clé anon est faite pour être publique — c'est la row level security
# qui protège les données. Ne mettez jamais service_role ici.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
