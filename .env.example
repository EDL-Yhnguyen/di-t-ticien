# Copiez ce fichier en .env et remplissez les deux valeurs.
# Sans elles, l'application fonctionne quand même : les données restent
# alors dans le navigateur (mode démo, pas de synchronisation entre appareils).
#
# Où les trouver : dashboard Supabase > votre projet > Settings > API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
